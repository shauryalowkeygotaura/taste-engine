# local active-project pointer (per machine, not shared)
profiles/.active

# moodboard source images are NOT published (may be copyrighted references).
# the extracted text taste-dna.md IS committed; the images are not.
profiles/**/moodboard/*
!profiles/**/moodboard/.gitkeep

# where those images came from (Pinterest board URLs are personal). same rule as
# the images: local only. the derived taste-dna.md is what travels.
profiles/**/moodboard-sources.md

# installed skill pointer, if generated inside the repo
.taste-root

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
